# Copy to `.env` on the server.

# --- Shared VPS (default): app only, bound to localhost ---
# Your existing reverse proxy terminates TLS and forwards to this port:
APP_PUBLISH_PORT=3300

NEXT_PUBLIC_SITE_URL=https://treecare.qubixsolution.com
# NEXT_PUBLIC_FACEBOOK_URL=
# NEXT_PUBLIC_CONTACT_EMAIL=
# TZ=UTC

# --- Optional: docker compose -f docker-compose.yml -f docker-compose.traefik.yml up -d
# (requires free :80 and :443 on the machine)
# ACME_EMAIL=you@example.com
# HTTP_PORT=80
# HTTPS_PORT=443
