# Copy to `.env` on the server.

# --- Qubix nginx (docker) reverse proxy ---
# Must match the network `qubix-nginx` is on:
#   docker inspect qubix-nginx --format '{{json .NetworkSettings.Networks}}' | grep -o '"[^"]*qubix[^"]*"'
# If this network does not exist yet on your machine, create it once (name must match):
#   docker network create qubix-solutions_qubix-net
QUBIX_DOCKER_NETWORK=qubix-solutions_qubix-net

# App exposed on host loopback (optional; qubix-nginx uses Docker DNS to the container)
APP_PUBLISH_PORT=3300

NEXT_PUBLIC_SITE_URL=https://treecare.qubixsolution.com
# NEXT_PUBLIC_FACEBOOK_URL=
# NEXT_PUBLIC_CONTACT_EMAIL=
# NEXT_PUBLIC_CONTACT_PHONE=07000 000000
# TZ=UTC

# --- Optional: bundled Traefik (only if host :80/:443 are free) ---
# docker compose -f docker-compose.yml -f docker-compose.traefik.yml up -d --build
# ACME_EMAIL=you@example.com
# HTTP_PORT=80
# HTTPS_PORT=443
